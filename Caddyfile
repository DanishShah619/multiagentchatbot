# Caddyfile for CortexAI Platform
# Caddy automatically provisions and renews HTTPS SSL certificates via Let's Encrypt / ZeroSSL
# Replace yourdomain.com with your actual domain name pointed to this EC2's Elastic IP.

yourdomain.com {
    # Reverse proxy to Express Gateway via Docker internal network
    reverse_proxy gateway:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # OWASP Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "0"
        Referrer-Policy "no-referrer-when-downgrade"
        # Allow Firebase Google Sign-in popup to communicate back with parent window
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        -Server
    }

    # Enable compression
    encode gzip
}
